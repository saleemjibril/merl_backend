PORT=4001
# Required on Vercel (Atlas connection string). Local demo can use memory DB.
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/merl?retryWrites=true&w=majority
# Local only — never enable on Vercel:
# USE_MEMORY_DB=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
# On Vercel this defaults to /tmp/uploads/evidence
UPLOAD_DIR=uploads/evidence
